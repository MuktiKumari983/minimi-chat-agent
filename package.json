{
  "name": "minimi-chat-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready streaming chat agent with temporal awareness, web search and persistent session memory.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/prompt.test.ts src/tests/session.test.ts src/tests/search.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "openai": "^7.56.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
