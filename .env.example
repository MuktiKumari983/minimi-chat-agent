# ---------------------------------------------------------------------------
# Minimi Chat Agent — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Only LLM_API_KEY is strictly required; web search falls back to DuckDuckGo
# (keyless) when TAVILY_API_KEY is absent.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Set to true only when running behind a trusted reverse proxy (nginx, Render,
# Fly, etc.) so rate limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info

# --- LLM (any OpenAI-compatible chat-completions provider) ------------------
# OpenAI, Groq, Together, OpenRouter, Azure OpenAI, Ollama, vLLM ...
LLM_API_KEY=sk-your-key-here
# Examples:
#   OpenAI       https://api.openai.com/v1
#   Groq         https://api.groq.com/openai/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
# Must support function/tool calling + streaming.
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2
# 0 = let the provider decide. Set e.g. 1200 to cap answer length.
LLM_MAX_OUTPUT_TOKENS=0
# Some OpenAI-compatible providers do not support stream_options. The agent
# automatically retries once without it if the provider rejects it.
LLM_STREAM_USAGE=true

# --- Web search -------------------------------------------------------------
# auto | tavily | duckduckgo
#   auto      -> Tavily when TAVILY_API_KEY is present, else DuckDuckGo
#   tavily    -> force Tavily (requires key)
#   duckduckgo-> force the keyless DuckDuckGo HTML fallback
SEARCH_PROVIDER=auto
# Get a key at https://tavily.com (free tier available).
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=12000
SEARCH_CACHE_TTL_MS=300000
SEARCH_CACHE_MAX_ENTRIES=200

# --- Agent behaviour --------------------------------------------------------
# Maximum number of tool-calling rounds before the agent is forced to answer.
MAX_TOOL_ITERATIONS=4
# Number of raw chat messages sent back to the model (in addition to the
# timestamped timeline in the system prompt).
MAX_HISTORY_MESSAGES=24
TIMELINE_MAX_ENTRIES=80
TIMELINE_MAX_CHARS=6000
MAX_MESSAGE_CHARS=8000

# --- Sessions ---------------------------------------------------------------
SESSION_TTL_MINUTES=1440
MAX_SESSIONS=1000
MAX_MESSAGES_PER_SESSION=200
PERSIST_SESSIONS=true
SESSION_FILE=data/sessions.json

# --- HTTP rate limiting -----------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
